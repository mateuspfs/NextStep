# === .gitignore unificado para NextStep (.NET API + React Frontend) ===

# --- IDEs e Editores ---
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Frontend (React / Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/out/
frontend/.next/
frontend/coverage/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.eslintcache
frontend/.parcel-cache
frontend/.cache/
frontend/vite.config.js.timestamp-*
frontend/vite.config.ts.timestamp-*

# --- Backend (API .NET) ---
# Builds e Binários
api/**/bin/
api/**/obj/
api/bin/
api/obj/

# Arquivos do compilador C#
*.suo
*.user
*.userosscache
*.sln.docstates
*.suo.tmp
*.userprefs
*.csproj.user

# Arquivos de cache do .NET
*.dll
*.pdb
*.cache

# Arquivos temporários do dotnet-ef
api/Migrations/**/MigrationsSnapshot.cs
api/**/MigrationsSnapshot.cs

# Arquivos de configurações sensíveis / Ambiente
api/**/appsettings.Development.json
api/**/appsettings.Local.json
api/**/secrets.json
api/secrets.json
.env

# Publish output
api/**/publish/

# Testes (.NET)
api/**/TestResults/
api/**/coverage/
api/**/TestResults.xml

# Arquivos temporários do Visual Studio
.vs/
*.VisualState.xml
*.dbmdl
*.pfx
*.publishsettings

# --- Infrastructure (Terraform) ---
infra/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Outros ---
# Scripts temporários de conversão ou automação
conversion_script.js
node_modules/
